{
  "manifest_version": 3,
  "name": "Tab Organiser",
  "version": "1.6.0",
  "description": "Groups your tabs with Chrome's built-in Gemini Nano, saves pages for later with reminders, and keeps a library.",
  "minimum_chrome_version": "138",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications", "contextMenus", "favicon", "scripting", "activeTab", "idle", "sidePanel"],
  "optional_host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Organiser",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current page for later"
    },
    "save-phrase": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Save the selected word or phrase to the Phrasebook"
    },
    "organise-window": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Organise this window's tabs into groups"
    },
    "open-library": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open the Library"
    },
    "highlight": {
      "description": "Highlight the selected text and open the notes panel"
    }
  }
}
